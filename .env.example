# Copy to .env at the repository root. Bun loads it from the working directory,
# so run every `bun run` command from the root. See README.md, step 1.

# Postgres 17 + pgvector, as started by `bun run db:up` (docker-compose.yml)
DATABASE_URL=postgres://kamin:kamin@localhost:5433/kamin

# Where Ollama runs. Another machine works: http://<host>:11434
OLLAMA_HOST=http://127.0.0.1:11434

# Models, as provider:model. Only Ollama embeddings are wired.
# Roles not listed here default to ollama:qwen3.5:9b.
COORDINATOR_MODEL=ollama:qwen3.5:9b
EMBEDDING_MODEL=ollama:bge-m3
DETECTIVE_MODEL=ollama:qwen3.5:9b
SPECIFIER_MODEL=ollama:qwen3.5:9b
AUDITOR_MODEL=ollama:qwen3.5:9b
ADVISOR_MODEL=ollama:qwen3.5:9b

# Web search. Needed by detective, swarm, hunt, spec:pass, record-cold-miss and
# "Investigate live" in the web app. Everything else runs without it.
TAVILY_API_KEY=

# Read by the provider SDKs only when a role above is set to that provider,
# e.g. AUDITOR_MODEL=anthropic:claude-sonnet-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
